class TreeNode:
    def __init__(self, val=0):
        self.val = val
        self.left = None
        self.right = None

def mergeTrees(t1, t2):
    if not t1:
        return t2
    if not t2:
        return t1

    merged = TreeNode(t1.val + t2.val)
    merged.left = mergeTrees(t1.left, t2.left)
    merged.right = mergeTrees(t1.right, t2.right)

    return merged

# Example
t1 = TreeNode(1)
t1.left = TreeNode(3)
t1.right = TreeNode(2)

t2 = TreeNode(2)
t2.left = TreeNode(1)
t2.right = TreeNode(3)

merged_tree = mergeTrees(t1, t2)
print("Root value:", merged_tree.val)
