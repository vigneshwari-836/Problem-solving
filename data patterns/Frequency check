def highest_frequency_chars(line):
    freq = {}

    for ch in line:
        if ch.isalpha():
            freq[ch] = freq.get(ch, 0) + 1

    max_freq = max(freq.values())

    result = [ch for ch in freq if freq[ch] == max_freq]

    result.sort(key=lambda x: (x.islower(), x))

    print("Highest frequency letters:", "".join(result))
    print("Frequency:", max_freq)

# Example
line = "aAbBBccC"
highest_frequency_chars(line)
