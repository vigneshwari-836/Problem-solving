from datetime import datetime

def check_dates(date1, date2):
    d1 = datetime.strptime(date1, "%d-%m-%Y")
    d2 = datetime.strptime(date2, "%d-%m-%Y")

    # Ensure d1 is earlier
    if d1 > d2:
        d1, d2 = d2, d1

    if d1.day == d2.day and (
        (d2.month == d1.month + 1 and d2.year == d1.year) or
        (d1.month == 12 and d2.month == 1 and d2.year == d1.year + 1)
    ):
        print("Exactly 1 month apart")
    else:
        print("Less than 1 month apart")

# Examples
check_dates("06-06-2011", "06-07-2011")
check_dates("15-12-2010", "15-01-2011")
check_dates("01-03-2011", "25-03-2011")
