import re
from  collections import Counter 

class Solution:
    def mostCommonWord(self, paragraph: str, banned: List[str]) -> str:
        nor_str=re.sub(r"[.,?!:;']"," ",paragraph).lower()  # removing punctuations
        words=nor_str.split()  # split the words
        ban=set(banned)    # unique banned words 
        word_count= Counter(word for word in words if word not in ban ) # count the frequency
        return word_count.most_common(1)[0][0]  # top first word in the count

