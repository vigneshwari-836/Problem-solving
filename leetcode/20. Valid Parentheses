lass Solution:
    def isValid(self, s: str) -> bool:
        stack=[]

        bracket_map= { "}":"{", "]":"[", ")":"("}

        for i in s:
            if i in bracket_map:
                top=stack.pop() if stack else '#'

                if top != bracket_map[i]:
                    return False
            else:
                stack.append(i)
        
        return len(stack)==0
