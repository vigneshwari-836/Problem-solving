from collections import Counter
class Solution(object):
    def isAnagram(self, s, t):
        """
        :type s: str
        :type t: str
        :rtype: bool
        """
        l1=len(s)
        l2=len(t)
        if l1!=l2:
            return False
        if Counter(s)==Counter(t):
            return True
        else:
            return False
            

        
