class Solution:
    def checkGoodInteger(self, n: int) -> bool:
        sum=0
        s_sum=0
        num=n
        while num!=0:
            rem=num%10
            sum+=rem
            s_sum+=rem*rem
            num=num//10
       
        if (s_sum-sum) >=50:
            return True
        else:
            return False
        
