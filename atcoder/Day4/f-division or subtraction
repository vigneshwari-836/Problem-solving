import math

n=int(input())
num=n
c=0
checked_bases=set()
potential_bases=set()
limit= int(math.isqrt(num))+1
for i in range(1,limit):
    if (num-1)%i==0:
        potential_bases.add(i)
        potential_bases.add((num-1)//i)
        
    if num%i==0:
        potential_bases.add(i)
        potential_bases.add(num//i)

for k in sorted(potential_bases):
    if k <2:
        continue
    
    if num%k==0:
        temp=num
        while temp%k==0:
            temp//=k
        if temp %k==1:
            c+=1
    else:
        if num%k==1:
            c+=1
    
print(c)
        
