#include <stdio.h>

void solve() {
    int n;
    scanf("%d", &n);
    
    // Print the numbers from n + 1 to 2*n
    for (int i = 1; i <= n; i++) {
        printf("%d", n + i);
        if (i < n) {
            printf(" ");
        }
    }
    printf("\n");
}

int main() {
    int t;
    if (scanf("%d", &t) != 1) return 0;
    
    while (t--) {
        solve();
    }
    
    return 0;
}
