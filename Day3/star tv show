import sys

def solve():

        n = int(sys.stdin.readline().strip())
    

    res = []
    
    for _ in range(n):
      
        line = sys.stdin.readline().split()
        if not line:
            continue
        s, k = map(int, line)
        
       
        val_str = sys.stdin.readline().strip()
        val = list(val_str)
        
      
        i = 0
        while i + k < s:
            # If the current bit is '1', we MUST flip it and its partner at (i + k)
            if val[i] == '1':
                val[i] = '0'
                
                # Flip the element at the jump destination (i + k)
                if val[i + k] == '1':
                    val[i + k] = '0'
                else:
                    val[i + k] = '1'
            i += 1
        
        
        if '1' in val:
            res.append(0) 
        else:
            res.append(1)  
        for outcome in res:
        if outcome == 1:
            print("YES")
        else:
            print("NO")

if __name__ == '__main__':
    solve()
