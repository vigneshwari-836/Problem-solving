if __name__ == "__main__":
    # Sample highly repetitive file data
    original_data = "WWWWWWWWWWWWBWWWWWWWWWWWWBBBWWWWWWWWWWWWWWWWWWWWWWWWB"
    print(f"Original Data:   {original_data}")
    print(f"Original Size:   {len(original_data)} characters\n")

    # Run the compression phase
    compressed = rle_compress(original_data)
    print(f"Compressed Data: {compressed}")
    print(f"Compressed Size: {len(compressed)} characters\n")

    # Run the decompression phase
    decompressed = rle_decompress(compressed)
    print(f"Dedecompressed:  {decompressed}")
    
    # Validation check
    print(f"Success Match:   {original_data == decompressed}")
