class Node:
    def __init__(self, data):
        self.data = data
        self.left = None   # Previous pointer in DLL
        self.right = None  # Next pointer in DLL


class Solution:
    def __init__(self):
        self.prev = None
        self.head = None

    def bToDLL(self, root):
        if root is None:
            return

        # Convert left subtree
        self.bToDLL(root.left)

        # Process current node
        if self.prev is None:
            self.head = root
        else:
            root.left = self.prev
            self.prev.right = root

        self.prev = root

        # Convert right subtree
        self.bToDLL(root.right)

        return self.head


# Function to print DLL forward
def print_forward(head):
    last = None
    while head:
        print(head.data, end=" ")
        last = head
        head = head.right
    print()
    return last


# Function to print DLL backward
def print_backward(last):
    while last:
        print(last.data, end=" ")
        last = last.left
    print()


# Example 1
root = Node(1)
root.left = Node(3)
root.right = Node(2)

obj = Solution()
head = obj.bToDLL(root)

last = print_forward(head)
print_backward(last)
