class Node:
   def __init__(self,data):
      self.data=data
      self.next=None

class Linkedlist:
   def __init__(self):
      self.head=None

   def print_list(self):
      curr=my_list.head
      while curr is not None:
         print(curr.data, end="->")
         curr=curr.next
      print("None")

my_list=Linkedlist()
n=int(input("Enter no of elements:"))
val=[1]*n
print("Enter elements:")
for i in range(n):
   v=int(input())
   val[i]=Node(v)
my_list.head=val[0]
for i in range(0,n-1):
   val[i].next=val[i+1]

my_list.print_list()

#Reverse the list

prev=None
curr=my_list.head
nxt=None

while curr is not  None:
    nxt=curr.next
    curr.next=prev
    prev=curr
    curr=nxt
my_list.head=prev
my_list.print_list()

#finding middle in the list

c=0
curr=my_list.head
while curr is not None:
    curr=curr.next
    c+=1
mid=int(c/2)
c=0
curr=my_list.head
while curr is not None:
    curr=curr.next
